        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "nodes",
          "edges"
        ],
        "title": "Pipeline"
      },
      "Project": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "prompt": {
            "type": "string",
            "title": "Prompt"
          },
          "pipeline": {
            "$ref": "#/components/schemas/Pipeline-Output"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "prompt",
          "pipeline",
          "created_at"
        ],
        "title": "Project"
      },
      "ProjectCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "default": "EMG gesture demo"
          },
          "prompt": {
            "type": "string",
            "maxLength": 2000,
            "title": "Prompt",
            "default": "Show a gesture when the simulated muscle signal activates."
          },
          "template": {
            "type": "string",
            "const": "emg-demo",
            "title": "Template",
            "default": "emg-demo"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ProjectCreate"
      },
      "SampleBatch": {
        "properties": {
          "stream": {
            "$ref": "#/components/schemas/StreamDescriptor"
          },
          "timestamps": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "minItems": 1,
            "title": "Timestamps"
          },
          "samples": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "minItems": 1,
            "title": "Samples"
          },
          "sequence": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Sequence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "stream",
          "timestamps",
          "samples",
          "sequence"
        ],
        "title": "SampleBatch"
      },
      "Session": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "project_id": {
            "type": "string",
            "format": "uuid",
            "title": "Project Id"
          },
          "pipeline": {
            "$ref": "#/components/schemas/Pipeline-Output"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "stopped",
              "failed",
              "interrupted"
            ],
            "title": "Status",
            "default": "running"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "ended_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ended At"
          },
          "raw": {
            "items": {
              "$ref": "#/components/schemas/SampleBatch"
            },
            "type": "array",
            "title": "Raw"
          },
          "inferences": {
            "items": {
              "$ref": "#/components/schemas/Inference"
            },
            "type": "array",
            "title": "Inferences"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "simulated": {
            "type": "boolean",
            "title": "Simulated",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "project_id",
          "pipeline",
          "status",
          "started_at",
          "ended_at",
          "raw",
          "inferences",
          "error",
          "simulated"
        ],
        "title": "Session"
      },
      "StreamDescriptor": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "device_id": {
            "type": "string",
            "title": "Device Id"
          },
          "modality": {
            "type": "string",
            "title": "Modality"
          },
          "sample_rate_hz": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Sample Rate Hz"
          },
          "channels": {
            "items": {
              "$ref": "#/components/schemas/Channel"
            },
            "type": "array",
            "minItems": 1,
            "title": "Channels"
          },
          "delivery": {
            "type": "string",
            "enum": [
              "live",
              "batch",
              "simulated"
            ],
            "title": "Delivery"
          },
          "clock": {
            "type": "string",
            "const": "unix_seconds",
            "title": "Clock",
            "default": "unix_seconds"
