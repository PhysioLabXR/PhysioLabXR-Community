            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Inference": {
        "properties": {
          "timestamp": {
            "type": "number",
            "title": "Timestamp"
          },
          "model_id": {
            "type": "string",
            "title": "Model Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "simulated": {
            "type": "boolean",
            "title": "Simulated",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "timestamp",
          "model_id",
          "label",
          "value",
          "unit",
          "simulated"
        ],
        "title": "Inference"
      },
      "Node-Input": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "device",
              "processing",
              "model",
              "application"
            ],
            "title": "Kind"
          },
          "implementation": {
            "type": "string",
            "title": "Implementation"
          },
          "parameters": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "type": "object",
            "title": "Parameters"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "kind",
          "implementation"
        ],
        "title": "Node"
      },
      "Node-Output": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "device",
              "processing",
              "model",
              "application"
            ],
            "title": "Kind"
          },
          "implementation": {
            "type": "string",
            "title": "Implementation"
          },
          "parameters": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "type": "object",
            "title": "Parameters"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "kind",
          "implementation",
          "parameters"
        ],
        "title": "Node"
      },
      "Pipeline-Input": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/Node-Input"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Nodes"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/Edge"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Edges"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nodes",
          "edges"
        ],
        "title": "Pipeline"
      },
      "Pipeline-Output": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/Node-Output"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Nodes"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/Edge"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Edges"
