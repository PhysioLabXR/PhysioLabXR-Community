        "additionalProperties": false,
        "type": "object",
        "required": [
          "devices",
          "processors",
          "models",
          "targets"
        ],
        "title": "Catalog"
      },
      "Channel": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "unit"
