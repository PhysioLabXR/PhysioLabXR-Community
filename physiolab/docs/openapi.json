              "live",
              "batch",
              "simulated",
              "unverified"
            ],
            "title": "Delivery"
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "planned",
              "legacy-adapter"
            ],
            "title": "Status"
          },
          "notes": {
            "type": "string",
            "title": "Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "delivery",
          "status",
          "notes"
        ],
        "title": "DeviceInfo"
      },
